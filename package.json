{
  "name": "agents-mcp",
  "version": "0.1.11",
  "description": "Standalone MCP server plus local panel that lets one agent orchestrate the other agent CLIs installed on this machine.",
  "type": "module",
  "bin": {
    "agents-mcp": "bin/agents-mcp.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "build:exe": "node scripts/build-exe.mjs",
    "connect:dsh": "node scripts/connect.mjs dsh",
    "connect:codex": "node scripts/connect.mjs codex",
    "connect:claude": "node scripts/connect.mjs claude",
    "pack:zip": "node scripts/pack-zip.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "multi-agent",
    "orchestration",
    "codex",
    "antigravity",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0721-art/Agents-MCP.git"
  },
  "files": [
    "bin/",
    "src/",
    "panel/",
    "fixtures/fake-agent.js",
    "docs/ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "homepage": "https://github.com/0721-art/Agents-MCP#readme",
  "bugs": {
    "url": "https://github.com/0721-art/Agents-MCP/issues"
  }
}
