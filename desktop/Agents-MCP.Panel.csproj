<Project Sdk="Microsoft.NET.Sdk">
  <!-- A native window around the local panel: WinForms hosts WebView2, which every
       Windows 10/11 machine already carries. Nothing else of .NET leaks into the product;
       the service keeps running in Agents-MCP.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Agents-MCP.Panel</AssemblyName>
    <RootNamespace>AgentsMcp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- One file, so an in-panel update can replace the window program itself: the update
         ships two assets and swaps them, which only works if each is a single file. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
</Project>
